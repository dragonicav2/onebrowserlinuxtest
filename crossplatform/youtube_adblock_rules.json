{
  "version": "2026.11.11.1",
  "description": "Shared Cross-Platform YouTube & Universal Ad-Block Ruleset for OneBrowser / ZeroBrowser (Linux, Windows, Android)",
  "ad_domains": [
    "doubleclick.net",
    "googlesyndication.com",
    "googleadservices.com",
    "google-analytics.com",
    "googletagmanager.com",
    "imasdk.googleapis.com",
    "pagead2.googlesyndication.com",
    "adservice.google.com",
    "fundingchoicesmessages.google.com",
    "2mdn.net",
    "adnxs.com",
    "rubiconproject.com",
    "pubmatic.com",
    "openx.net",
    "criteo.com",
    "taboola.com",
    "outbrain.com",
    "adsterra.com",
    "propellerads.com",
    "popads.net",
    "popcash.net",
    "exoclick.com",
    "realsrv.com",
    "juicyads.com",
    "trafficjunky.net",
    "acscdn.com",
    "chpadblock.com",
    "blockadblock.com",
    "fuckadblock.com",
    "admiral.com"
  ],
  "youtube_ad_path_patterns": [
    "/youtubei/v1/player/ad_break",
    "/api/stats/ads",
    "/pagead/interaction",
    "/pagead/lvz",
    "/pagead/adview",
    "/pagead/conversion",
    "/get_midroll_info",
    "/ptracking",
    "/ pcs/activeview"
  ],
  "youtube_ad_query_patterns": [
    "adformat=",
    "ad_type=",
    "ad_system=",
    "&oad=",
    "?oad="
  ],
  "json_prune_keys": [
    "adPlacements",
    "playerAds",
    "adSlots",
    "adBreakHeartbeatParams"
  ],
  "skip_button_selectors": [
    ".ytp-ad-skip-button",
    ".ytp-skip-ad-button",
    ".ytp-ad-skip-button-modern",
    ".ytp-ad-skip-button-slot button",
    ".ytp-ad-overlay-close-button",
    "button.ytp-ad-skip-button-modern"
  ],
  "cosmetic_selectors": [
    "ytd-ad-slot-renderer",
    "ytd-in-feed-ad-layout-renderer",
    "ytd-promoted-sparkles-web-renderer",
    "ytd-promoted-video-renderer",
    "ytd-display-ad-renderer",
    "ytd-statement-banner-renderer",
    "ytd-banner-promo-renderer",
    "ytd-video-masthead-ad-v3-renderer",
    "ytd-VideoMastheadAdV3Renderer",
    "ytd-primetime-promo-renderer",
    "ytd-companion-slot-renderer",
    "ytd-action-companion-ad-renderer",
    "ytd-image-companion-ad-renderer",
    "ytd- merchandise-shelf-renderer",
    "ytd-engagement-panel-section-list-renderer[target-id=\"engagement-panel-ads\"]",
    "ytd-enforcement-message-view-model",
    "ytm-promoted-sparkles-web-renderer",
    "ytm-promoted-video-renderer",
    "ytm-companion-ad-renderer",
    "ytm-statement-banner-renderer",
    "#masthead-ad",
    "#player-ads",
    "#offer-module",
    ".ytp-ad-overlay-container",
    ".ytp-ad-message-container",
    ".ytp-featured-product",
    ".ytd-mealbar-promo-renderer",
    "tp-yt-paper-dialog:has(ytd-enforcement-message-view-model)"
  ]
}
